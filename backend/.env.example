# Copy to backend/.env and fill in real values. This file is safe to commit.

APP_ENV=development
PORT=8001

# PostgreSQL connection string for the SkynexiaDM API database.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/skynexiadm?sslmode=disable

# Origin allowed by CORS (the Next.js web app).
FRONTEND_URL=http://localhost:3152

# Secret used to sign/verify auth JWTs. Use a long random value (32+ bytes).
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-min-32-characters
